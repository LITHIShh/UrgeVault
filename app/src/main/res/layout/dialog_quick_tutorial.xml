<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="26dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTutorialStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_liquid_glass_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Step 1 of 4"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDismissTutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:padding="4dp"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Big Hero Visual Container with Liquid Glass Violet Glow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_liquid_glass_card_violet">

            <TextView
                android:id="@+id/tvTutorialEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🛡️"
                android:textSize="54sp" />
        </FrameLayout>

        <!-- Dynamic Title & Description -->
        <TextView
            android:id="@+id/tvTutorialTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Welcome to UrgeVault"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTutorialDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="3dp"
            android:text="Your offline-first sanctuary. Protect yourself from betting sites, dopamine traps, and compulsive urges with zero data collection."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Step Indicator Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_breathing_circle"
                android:backgroundTint="@color/primary" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_breathing_circle"
                android:backgroundTint="@color/card_stroke" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_breathing_circle"
                android:backgroundTint="@color/card_stroke" />

            <View
                android:id="@+id/dot4"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_breathing_circle"
                android:backgroundTint="@color/card_stroke" />
        </LinearLayout>

        <!-- Bottom Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTutorialNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_liquid_gradient_button"
            android:elevation="4dp"
            android:text="Next →"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
