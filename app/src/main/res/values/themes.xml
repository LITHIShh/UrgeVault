<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BetShield" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- Fullscreen Block Theme -->
    <style name="Theme.BetShield.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#180A0A</item> <!-- Deep crimson dark -->
        <item name="android:statusBarColor">#180A0A</item>
        <item name="android:navigationBarColor">#180A0A</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.BetShield.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
    </style>
</resources>
